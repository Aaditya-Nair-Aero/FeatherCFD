#version 450 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba16f, binding = 0) uniform readonly image3D u_velocity;
layout(rgba16f, binding = 1) uniform writeonly image3D u_velocity_out;
layout(r8ui,    binding = 2) uniform readonly uimage3D u_obstacle;
layout(r16f,    binding = 3) uniform readonly image3D u_sdf;

layout(push_constant) uniform Params {
    float u_dt;
    float u_viscosity;
    float u_sgs_coeff;
    float pad0;
    vec3 u_inflow_vel;
    float pad1;
} params;

vec3 weno5_1d(vec3 f[5], float xi) {
    vec3 p0 = f[0] * xi*(xi+1.0)*0.5 + f[1] * (-xi*(xi+2.0)) + f[2] * (xi+1.0)*(xi+2.0)*0.5;
    vec3 p1 = f[1] * xi*(xi-1.0)*0.5 + f[2] * (1.0 - xi*xi) + f[3] * xi*(xi+1.0)*0.5;
    vec3 p2 = f[2] * (xi-1.0)*(xi-2.0)*0.5 + f[3] * (-xi*(xi-2.0)) + f[4] * xi*(xi-1.0)*0.5;

    vec3 d2a = f[0] - 2.0*f[1] + f[2];
    vec3 d2b = f[1] - 2.0*f[2] + f[3];
    vec3 d2c = f[2] - 2.0*f[3] + f[4];
    vec3 beta0 = 1.083333333 * d2a*d2a + 0.25 * (f[0] - 4.0*f[1] + 3.0*f[2])*(f[0] - 4.0*f[1] + 3.0*f[2]);
    vec3 beta1 = 1.083333333 * d2b*d2b + 0.25 * (f[1] - f[3])*(f[1] - f[3]);
    vec3 beta2 = 1.083333333 * d2c*d2c + 0.25 * (3.0*f[2] - 4.0*f[3] + f[4])*(3.0*f[2] - 4.0*f[3] + f[4]);

    float d0_opt = (xi - 1.0)*(xi - 2.0) / 12.0;
    float d1_opt = (4.0 - xi*xi) / 6.0;
    float d2_opt = (xi + 1.0)*(xi + 2.0) / 12.0;

    float eps = 1e-6;
    vec3 a0 = d0_opt / ((beta0 + eps)*(beta0 + eps));
    vec3 a1 = d1_opt / ((beta1 + eps)*(beta1 + eps));
    vec3 a2 = d2_opt / ((beta2 + eps)*(beta2 + eps));
    vec3 sum_a = a0 + a1 + a2;

    return (a0 * p0 + a1 * p1 + a2 * p2) / sum_a;
}

vec3 weno5_sample(int binding, vec3 pos) {
    ivec3 i = ivec3(floor(pos));
    vec3 xi = pos - vec3(i);
    ivec3 sz = imageSize(u_velocity);

    vec3 zvals[5];
    for (int kk = -2; kk <= 2; kk++) {
        vec3 yvals[5];
        for (int jj = -2; jj <= 2; jj++) {
            vec3 xvals[5];
            for (int ii = -2; ii <= 2; ii++) {
                ivec3 tc = clamp(i + ivec3(ii, jj, kk), ivec3(0), sz - ivec3(1));
                xvals[ii + 2] = imageLoad(u_velocity, tc).xyz;
            }
            yvals[jj + 2] = weno5_1d(xvals, xi.x);
        }
        zvals[kk + 2] = weno5_1d(yvals, xi.y);
    }
    return weno5_1d(zvals, xi.z);
}

vec3 tri_sample(vec3 pos) {
    ivec3 i = ivec3(floor(pos));
    vec3 xi = pos - vec3(i);
    ivec3 sz = imageSize(u_velocity) - ivec3(1);
    ivec3 c00 = clamp(i + ivec3(0,0,0), ivec3(0), sz);
    ivec3 c10 = clamp(i + ivec3(1,0,0), ivec3(0), sz);
    ivec3 c01 = clamp(i + ivec3(0,1,0), ivec3(0), sz);
    ivec3 c11 = clamp(i + ivec3(1,1,0), ivec3(0), sz);
    ivec3 c00_1 = clamp(i + ivec3(0,0,1), ivec3(0), sz);
    ivec3 c10_1 = clamp(i + ivec3(1,0,1), ivec3(0), sz);
    ivec3 c01_1 = clamp(i + ivec3(0,1,1), ivec3(0), sz);
    ivec3 c11_1 = clamp(i + ivec3(1,1,1), ivec3(0), sz);
    vec3 v000 = imageLoad(u_velocity, c00).xyz;
    vec3 v100 = imageLoad(u_velocity, c10).xyz;
    vec3 v010 = imageLoad(u_velocity, c01).xyz;
    vec3 v110 = imageLoad(u_velocity, c11).xyz;
    vec3 v001 = imageLoad(u_velocity, c00_1).xyz;
    vec3 v101 = imageLoad(u_velocity, c10_1).xyz;
    vec3 v011 = imageLoad(u_velocity, c01_1).xyz;
    vec3 v111 = imageLoad(u_velocity, c11_1).xyz;

    vec3 v00 = v000 + (v100 - v000) * xi.x;
    vec3 v01 = v001 + (v101 - v001) * xi.x;
    vec3 v10 = v010 + (v110 - v010) * xi.x;
    vec3 v11 = v011 + (v111 - v011) * xi.x;
    vec3 v0 = v00 + (v10 - v00) * xi.y;
    vec3 v1 = v01 + (v11 - v01) * xi.y;
    return v0 + (v1 - v0) * xi.z;
}

vec3 sample_velocity(vec3 pos) {
    if (pos.x < 2.0 || pos.x > float(imageSize(u_velocity).x - 3) ||
        pos.y < 2.0 || pos.y > float(imageSize(u_velocity).y - 3) ||
        pos.z < 2.0 || pos.z > float(imageSize(u_velocity).z - 3)) {
        return tri_sample(pos);
    }
    return weno5_sample(0, pos);
}

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(u_velocity);
    if (any(greaterThanEqual(texel, size))) return;
    ivec3 max3 = size - ivec3(1);

    if (texel.x == 0) {
        imageStore(u_velocity_out, texel, vec4(params.u_inflow_vel, 1.0));
        return;
    }
    if (texel.x == max3.x) {
        vec3 u_current = imageLoad(u_velocity, texel).xyz;
        vec3 u_left = imageLoad(u_velocity, texel - ivec3(1, 0, 0)).xyz;
        float uc = params.u_inflow_vel.x;
        float cfl = min(uc * params.u_dt, 0.5);
        imageStore(u_velocity_out, texel, vec4(u_current - cfl * (u_current - u_left), 1.0));
        return;
    }
    if (texel.y <= 0 || texel.y >= max3.y ||
        texel.z <= 0 || texel.z >= max3.z) {
        imageStore(u_velocity_out, texel, vec4(0.0));
        return;
    }

    float sdf = imageLoad(u_sdf, texel).r;
    float alpha = smoothstep(-0.5, 0.5, sdf);
    if (alpha < 0.001) {
        imageStore(u_velocity_out, texel, vec4(0.0));
        return;
    }

    vec3 u = imageLoad(u_velocity, texel).xyz;
    vec3 pos = vec3(texel) + 0.5;

    vec3 pos_fwd = pos - params.u_dt * u;
    vec3 u_fwd = sample_velocity(pos_fwd);

    vec3 pos_back = pos_fwd + params.u_dt * u_fwd;
    vec3 u_back = sample_velocity(pos_back);

    vec3 u_orig = imageLoad(u_velocity, texel).xyz;
    vec3 u_new  = u_fwd + 0.5 * (u_orig - u_back);

    ivec3 st = ivec3(pos_fwd - 0.5);
    vec3 n000 = imageLoad(u_velocity, clamp(st + ivec3(0,0,0), ivec3(0), max3)).xyz;
    vec3 n100 = imageLoad(u_velocity, clamp(st + ivec3(1,0,0), ivec3(0), max3)).xyz;
    vec3 n010 = imageLoad(u_velocity, clamp(st + ivec3(0,1,0), ivec3(0), max3)).xyz;
    vec3 n110 = imageLoad(u_velocity, clamp(st + ivec3(1,1,0), ivec3(0), max3)).xyz;
    vec3 n001 = imageLoad(u_velocity, clamp(st + ivec3(0,0,1), ivec3(0), max3)).xyz;
    vec3 n101 = imageLoad(u_velocity, clamp(st + ivec3(1,0,1), ivec3(0), max3)).xyz;
    vec3 n011 = imageLoad(u_velocity, clamp(st + ivec3(0,1,1), ivec3(0), max3)).xyz;
    vec3 n111 = imageLoad(u_velocity, clamp(st + ivec3(1,1,1), ivec3(0), max3)).xyz;
    vec3 u_min = min(min(min(n000, n100), min(n010, n110)), min(min(n001, n101), min(n011, n111)));
    vec3 u_max = max(max(max(n000, n100), max(n010, n110)), max(max(n001, n101), max(n011, n111)));
    u_new = clamp(u_new, u_min, u_max);

    ivec3 iL = clamp(texel - ivec3(1,0,0), ivec3(0), max3);
    ivec3 iR = clamp(texel + ivec3(1,0,0), ivec3(0), max3);
    ivec3 iD = clamp(texel - ivec3(0,1,0), ivec3(0), max3);
    ivec3 iU = clamp(texel + ivec3(0,1,0), ivec3(0), max3);
    ivec3 iB = clamp(texel - ivec3(0,0,1), ivec3(0), max3);
    ivec3 iF = clamp(texel + ivec3(0,0,1), ivec3(0), max3);

    vec3 uL = imageLoad(u_velocity, iL).xyz;
    if (imageLoad(u_sdf, iL).r < 0.0) uL = u;
    vec3 uR = imageLoad(u_velocity, iR).xyz;
    if (imageLoad(u_sdf, iR).r < 0.0) uR = u;
    vec3 uD = imageLoad(u_velocity, iD).xyz;
    if (imageLoad(u_sdf, iD).r < 0.0) uD = u;
    vec3 uU = imageLoad(u_velocity, iU).xyz;
    if (imageLoad(u_sdf, iU).r < 0.0) uU = u;
    vec3 uB = imageLoad(u_velocity, iB).xyz;
    if (imageLoad(u_sdf, iB).r < 0.0) uB = u;
    vec3 uF = imageLoad(u_velocity, iF).xyz;
    if (imageLoad(u_sdf, iF).r < 0.0) uF = u;

    float gxx = (uR.x - uL.x) * 0.5;
    float gxy = (uU.x - uD.x) * 0.5;
    float gxz = (uF.x - uB.x) * 0.5;
    float gyx = (uR.y - uL.y) * 0.5;
    float gyy = (uU.y - uD.y) * 0.5;
    float gyz = (uF.y - uB.y) * 0.5;
    float gzx = (uR.z - uL.z) * 0.5;
    float gzy = (uU.z - uD.z) * 0.5;
    float gzz = (uF.z - uB.z) * 0.5;

    float Sxx = gxx;
    float Syy = gyy;
    float Szz = gzz;
    float Sxy = (gxy + gyx) * 0.5;
    float Sxz = (gxz + gzx) * 0.5;
    float Syz = (gyz + gzy) * 0.5;

    float S2 = Sxx*Sxx + Syy*Syy + Szz*Szz + 2.0*(Sxy*Sxy + Sxz*Sxz + Syz*Syz);

    float Gxx = gxx*gxx + gxy*gyx + gxz*gzx;
    float Gxy = gxx*gxy + gxy*gyy + gxz*gzy;
    float Gxz = gxx*gxz + gxy*gyz + gxz*gzz;
    float Gyx = gyx*gxx + gyy*gyx + gyz*gzx;
    float Gyy = gyx*gxy + gyy*gyy + gyz*gzy;
    float Gyz = gyx*gxz + gyy*gyz + gyz*gzz;
    float Gzx = gzx*gxx + gzy*gyx + gzz*gzx;
    float Gzy = gzx*gxy + gzy*gyy + gzz*gzy;
    float Gzz = gzx*gxz + gzy*gyz + gzz*gzz;

    float Gkk = Gxx + Gyy + Gzz;

    float Sdxx = Gxx - Gkk * 0.33333333;
    float Sdyy = Gyy - Gkk * 0.33333333;
    float Sdzz = Gzz - Gkk * 0.33333333;
    float Sdxy = (Gxy + Gyx) * 0.5;
    float Sdxz = (Gxz + Gzx) * 0.5;
    float Sdyz = (Gyz + Gzy) * 0.5;

    float Sd2 = Sdxx*Sdxx + Sdyy*Sdyy + Sdzz*Sdzz + 2.0*(Sdxy*Sdxy + Sdxz*Sdxz + Sdyz*Sdyz);

    float Cw = params.u_sgs_coeff;
    float delta = 1.0;
    float Cw2_d2 = Cw * Cw * delta * delta;
    float S2_safe = max(S2, 1e-20);
    float Sd2_safe = max(Sd2, 1e-20);
    float nu_t = Cw2_d2 * pow(Sd2_safe, 1.5) / (pow(S2_safe, 2.5) + pow(Sd2_safe, 1.25));

    float lap_x = uL.x + uR.x + uD.x + uU.x + uB.x + uF.x - 6.0 * u_new.x;
    float lap_y = uL.y + uR.y + uD.y + uU.y + uB.y + uF.y - 6.0 * u_new.y;
    float lap_z = uL.z + uR.z + uD.z + uU.z + uB.z + uF.z - 6.0 * u_new.z;
    float total_nu = nu_t + params.u_viscosity;
    float visc_scale = min(params.u_dt * total_nu, 0.5);
    u_new += vec3(lap_x, lap_y, lap_z) * visc_scale;

    imageStore(u_velocity_out, texel, vec4(u_new * alpha, 1.0));
}
