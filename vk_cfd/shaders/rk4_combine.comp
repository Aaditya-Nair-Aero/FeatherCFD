#version 450 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba16f, binding = 0) uniform readonly image3D u_init;
layout(rgba16f, binding = 1) uniform readonly image3D u_k1;
layout(rgba16f, binding = 2) uniform readonly image3D u_k2;
layout(rgba16f, binding = 3) uniform readonly image3D u_k3;
layout(rgba16f, binding = 4) uniform readonly image3D u_k4;
layout(rgba16f, binding = 5) uniform writeonly image3D u_out;

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(u_init);
    if (any(greaterThanEqual(texel, size))) return;

    vec4 init = imageLoad(u_init, texel);
    vec4 k1 = imageLoad(u_k1, texel);
    vec4 k2 = imageLoad(u_k2, texel);
    vec4 k3 = imageLoad(u_k3, texel);
    vec4 k4 = imageLoad(u_k4, texel);

    vec4 result = init + (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
    imageStore(u_out, texel, result);
}
