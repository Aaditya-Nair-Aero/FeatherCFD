#version 450 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba16f, binding = 0) uniform readonly image3D u_velocity;
layout(rgba16f, binding = 1) uniform writeonly image3D u_velocity_out;

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(u_velocity);
    if (any(greaterThanEqual(texel, size))) return;
    // Write (x+1)*0.01 so x=0 gives 0.01 (distinguishable from init zeros)
    imageStore(u_velocity_out, texel, vec4(float(texel.x + 1) * 0.01, 0.0, 0.0, 1.0));
}
